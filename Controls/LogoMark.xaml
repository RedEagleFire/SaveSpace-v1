<UserControl x:Class="SaveSpace.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="52" Height="52">
            <Path Data="M 7,45 L 7,7 L 15,7 L 37,34 L 37,7 L 45,7 L 45,45 L 37,45 L 15,18 L 15,45 Z"
                  StrokeThickness="0">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4350" Offset="0" />
                        <GradientStop Color="#E32636" Offset="0.48" />
                        <GradientStop Color="#8E1722" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.38" Color="#E32636" />
                </Path.Effect>
            </Path>
            <Path Data="M 7,7 L 15,7 L 15,17 Z" Fill="#7A0F18" Opacity="0.55" />
            <Path Data="M 37,45 L 45,45 L 45,34 Z" Fill="#FF6A74" Opacity="0.22" />
        </Canvas>
    </Viewbox>
</UserControl>
