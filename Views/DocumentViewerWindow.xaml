<Window x:Class="SaveSpace.Views.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Document — SaveSpace" Width="1160" Height="820" MinWidth="680" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Font.BodyFamily}"
        FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Ink}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="Shell" Margin="14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="42" />
            </Grid.RowDefinitions>

            <!-- Titelbalk -->
            <Border x:Name="TitleBar" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KindBadge" Width="30" Height="30" CornerRadius="{DynamicResource Radius.S}"
                            Background="{DynamicResource Brush.DocumentSoft}" VerticalAlignment="Center">
                        <TextBlock x:Name="KindIcon" Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Document}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                        <TextBlock x:Name="TitleText" Text="" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetaText" Text="" Style="{StaticResource Text.Tiny}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource Btn.IconSmall}" Content="&#xE76B;"
                                Click="Prev_Click" ToolTip="Vorige" Margin="1,0" />
                        <Button x:Name="NextButton" Style="{StaticResource Btn.IconSmall}" Content="&#xE76C;"
                                Click="Next_Click" ToolTip="Volgende" Margin="1,0" />
                        <Border Width="1" Height="18" Background="{DynamicResource Brush.Line}" Margin="7,0" />
                        <Button Style="{StaticResource Btn.Secondary}" Click="OpenExternal_Click" FontSize="10.5"
                                Padding="10,5" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="Extern openen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSmall}" Click="Fullscreen_Click" ToolTip="Volledig scherm"
                                Content="&#xE740;" Margin="1,0" />
                        <Button Style="{StaticResource Btn.IconSmall}" Click="Close_Click" ToolTip="Sluiten"
                                Content="&#xE8BB;" Margin="1,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inhoud -->
            <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}">
                <Grid x:Name="WebPanel" Visibility="Collapsed">
                    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#17181C" />
                    <Border x:Name="WebLoading" Background="{DynamicResource Brush.Canvas}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="150" Height="3" />
                            <TextBlock Text="Document laden…" Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ImagePanel" Visibility="Collapsed">
                    <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource Brush.Canvas}" PanningMode="Both">
                        <Image x:Name="Picture" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Image.LayoutTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                                    <RotateTransform x:Name="ImageRotate" Angle="0" />
                                </TransformGroup>
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="MediaPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="Black">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" />
                    </Border>
                    <Border x:Name="AudioCover" Background="{DynamicResource Brush.Canvas}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="132" Height="132" CornerRadius="{DynamicResource Radius.XL}"
                                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Text.Icon}" FontSize="48"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock x:Name="AudioTitle" Style="{StaticResource Text.H2}" HorizontalAlignment="Center"
                                       Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                            <TextBlock x:Name="AudioHint" Text="Druk op afspelen" Style="{StaticResource Text.Small}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="14,10">
                        <Button x:Name="PlayButton" Style="{StaticResource Btn.Primary}" Width="38" Height="38"
                                Padding="0" Click="Play_Click" Content="&#xE768;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                        <Slider x:Name="PositionSlider" Width="360" Margin="14,0,10,0" VerticalAlignment="Center"
                                ValueChanged="PositionSlider_ValueChanged" Thumb.DragStarted="PositionSlider_DragStarted"
                                Thumb.DragCompleted="PositionSlider_DragCompleted" />
                        <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Style="{StaticResource Text.Tiny}"
                                   VerticalAlignment="Center" Width="88" />
                        <TextBlock Text="&#xE767;" Style="{StaticResource Text.Icon}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" Margin="6,0,5,0" />
                        <Slider x:Name="VolumeSlider" Width="88" Minimum="0" Maximum="1" Value="0.8"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="FallbackPanel" Visibility="Collapsed">
                    <Border Width="560" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Padding="30,26"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Border Width="58" Height="58" CornerRadius="{DynamicResource Radius.L}"
                                    Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Left">
                                <TextBlock x:Name="FallbackIcon" Text="&#xE8A5;" Style="{StaticResource Text.Icon}"
                                           FontSize="24" Foreground="{DynamicResource Brush.Document}" />
                            </Border>
                            <TextBlock x:Name="FallbackTitle" Text="" Style="{StaticResource Text.H2}" Margin="0,16,0,6"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FallbackText" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                       LineHeight="20" />
                            <TextBlock x:Name="FallbackPath" Style="{StaticResource Text.Tiny}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Faint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Click="OpenExternal_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="Openen in standaardapp" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Secondary}" Content="Map openen" Click="ShowInFolder_Click"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="MessageBar" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentBorder}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Padding="12,8" Margin="18"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- Onderbalk -->
            <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE71F;" Click="ZoomOut_Click"
                                ToolTip="Uitzoomen" />
                        <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource Text.Tiny}" Width="48"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8A3;" Click="ZoomIn_Click"
                                ToolTip="Inzoomen" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Passend" Click="Fit_Click" FontSize="10.5"
                                Padding="8,4" Margin="4,0,0,0" />
                        <Button x:Name="RotateButton" Style="{StaticResource Btn.Ghost}" Content="Draaien" Click="Rotate_Click"
                                FontSize="10.5" Padding="8,4" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="Lokaal bestand · originelen blijven ongewijzigd" Style="{StaticResource Text.Tiny}"
                                   FontSize="10" Foreground="{DynamicResource Brush.Faint}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
