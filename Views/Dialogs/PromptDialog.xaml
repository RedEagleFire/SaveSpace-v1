<Window x:Class="SaveSpace.Views.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveSpace" Width="440" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Font.BodyFamily}"
        FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Ink}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="16" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <StackPanel>
            <Grid Margin="20,16,14,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Invoeren" Style="{StaticResource Text.H2}" />
                    <TextBlock x:Name="HintText" Text="" Style="{StaticResource Text.Tiny}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click" />
            </Grid>
            <StackPanel Margin="20,6,20,0">
                <TextBox x:Name="ValueBox" Style="{StaticResource Input}" />
                <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource Brush.Danger}" FontSize="10.5"
                           Margin="2,5,0,0" Visibility="Collapsed" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="20,11">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" Content="Annuleren" Click="Cancel_Click" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource Btn.Primary}" Content="OK" Click="Ok_Click" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
