<Window x:Class="SaveSpace.Views.Dialogs.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map kiezen" Width="440" Height="540" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.BodyFamily}" FontSize="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}">
    <Border Margin="20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Effect="{DynamicResource Shadow.Hover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.L}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,20,16,12">
                    <StackPanel>
                        <TextBlock Text="In welke map?" Style="{StaticResource Text.H3}" />
                        <TextBlock x:Name="SubtitleText" Text="Kies waar dit item hoort." Style="{StaticResource Text.Tiny}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Sluiten" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0">
                <ListBox x:Name="FolderList" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="FolderList_MouseDoubleClick" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="34" CornerRadius="4" Background="{Binding ColorBrush}"
                                        Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Text.Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="13"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Secondary}" Content="Annuleren" Click="Cancel_Click"
                            IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Toepassen" Click="Choose_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
