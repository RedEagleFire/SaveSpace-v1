<Window x:Class="SaveSpace.Views.Dialogs.ItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item kiezen — SaveSpace" Width="620" Height="520" MinWidth="460" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Font.BodyFamily}"
        FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Ink}">
    <Border Margin="16" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="22,18,16,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Item toevoegen" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="Kies een bestaand item uit je bibliotheek." Style="{StaticResource Text.Tiny}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Height="34" Padding="11,0" Margin="22,4,22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="11"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,7,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Zoek op naam…" Foreground="{DynamicResource Brush.Faint}" FontSize="11.5"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="11.5"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16,0">
                <ListBox x:Name="ItemList" SelectionChanged="ItemList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius.S}"
                                        Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,9,0">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{Binding AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Text.Tiny}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="Geen items gevonden." Style="{StaticResource Text.Small}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="22,12" Margin="0,10,0,0">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" Content="Annuleren" Click="Cancel_Click" HorizontalAlignment="Left" />
                    <Button x:Name="ChooseButton" Style="{StaticResource Btn.Primary}" Content="Toevoegen" Click="Choose_Click"
                            HorizontalAlignment="Right" IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
