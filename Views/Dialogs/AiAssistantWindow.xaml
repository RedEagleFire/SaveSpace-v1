<Window x:Class="SaveSpace.Views.Dialogs.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveSpace — AI-assistent" Width="760" Height="620" MinWidth="560" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.BodyFamily}" FontSize="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="18" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,18,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.M}"
                                Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="17"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI-assistent" Style="{StaticResource Text.H3}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="ModelText" Text="" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="Close_Click" ToolTip="Sluiten" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="18,0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.L}">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel>
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BubbleBrush}" CornerRadius="{DynamicResource Radius.M}"
                                            Padding="13,10" Margin="{Binding Margin}" MaxWidth="520"
                                            HorizontalAlignment="{Binding Alignment}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{Binding RoleBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{Binding TextBrush}" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="4,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Margin="18,12,18,16">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                        <TextBox x:Name="PromptBox" Background="Transparent" BorderThickness="0" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="58" MaxHeight="130" Padding="13,10"
                                 VerticalScrollBarVisibility="Auto" TextChanged="PromptBox_TextChanged" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button x:Name="SendButton" Style="{StaticResource Btn.Primary}" Click="Send_Click"
                                Content="Versturen" MinWidth="94" />
                        <Button x:Name="StopButton" Style="{StaticResource Btn.Secondary}" Click="Stop_Click"
                                Content="Stoppen" MinWidth="94" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Enter versturen · Shift+Enter nieuwe regel. Alleen je vraag wordt naar de gekozen AI-provider gestuurd."
                           Style="{StaticResource Text.Tiny}" FontSize="9.5" Margin="3,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
