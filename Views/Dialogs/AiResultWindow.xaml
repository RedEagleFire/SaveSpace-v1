<Window x:Class="SaveSpace.Views.Dialogs.AiResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-resultaat" Width="660" Height="560" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.BodyFamily}" FontSize="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}">
    <Border Margin="20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border CornerRadius="{DynamicResource Radius.XL}" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,20,16,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="{DynamicResource Radius.M}"
                                Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,13,0">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="17"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="AI-resultaat" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="Controleer de tekst voordat je hem toevoegt."
                                       Style="{StaticResource Text.Tiny}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="Close_Click" ToolTip="Sluiten" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="24,0,24,14" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}">
                <TextBox x:Name="ResultText" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="18,16" FontSize="{DynamicResource Font.Body}" VerticalContentAlignment="Top" />
            </Border>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" Content="Kopiëren" Click="Copy_Click"
                            HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Secondary}" Content="Sluiten" Click="Close_Click"
                                Margin="0,0,8,0" />
                        <Button x:Name="ReplaceButton" Style="{StaticResource Btn.Secondary}" Content="Vervangen"
                                Click="Replace_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="InsertButton" Style="{StaticResource Btn.Primary}" Content="Invoegen"
                                Click="Insert_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
