<Window x:Class="SaveSpace.Views.Dialogs.ProjectEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project — SaveSpace" Width="500" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Font.BodyFamily}"
        FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Ink}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="16" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <StackPanel>
            <Grid Margin="22,18,16,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Nieuw project" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="Geef je project een naam, kleur en icoon." Style="{StaticResource Text.Tiny}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Sluiten" />
            </Grid>

            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.M}" Padding="14,12"
                    Margin="22,4,22,14">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PreviewBadge" Width="40" Height="40" CornerRadius="{DynamicResource Radius.M}"
                            Background="#2EE32636">
                        <TextBlock x:Name="PreviewIcon" Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="18"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock x:Name="PreviewName" Text="Mijn project" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Project in SaveSpace" Style="{StaticResource Text.Tiny}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="22,0,22,0">
                <TextBlock Text="NAAM" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,6,0,0" TextChanged="NameBox_TextChanged"
                         MaxLength="80" />
                <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource Brush.Danger}" FontSize="10.5"
                           Margin="2,5,0,0" Visibility="Collapsed" />

                <TextBlock Text="KLEUR" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" Margin="0,16,0,0" />
                <WrapPanel x:Name="ColorPanel" Margin="0,7,0,0" />

                <TextBlock Text="ICOON" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" Margin="0,16,0,0" />
                <WrapPanel x:Name="IconPanel" Margin="0,7,0,0" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="22,12">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" Content="Annuleren" Click="Cancel_Click" HorizontalAlignment="Left" />
                    <Button x:Name="SaveButton" Style="{StaticResource Btn.Primary}" Click="Save_Click" HorizontalAlignment="Right"
                            Content="Project opslaan" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
