<Window x:Class="SaveSpace.Views.Dialogs.LinkEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weblink" Width="650" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.BodyFamily}" FontSize="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}">
    <Border Margin="20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Effect="{DynamicResource Shadow.Hover}">
        <StackPanel>
            <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="{DynamicResource Radius.M}"
                                Background="{DynamicResource Brush.LinkSoft}" Margin="0,0,14,0">
                            <TextBlock x:Name="HeaderIcon" Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="19"
                                       Foreground="{DynamicResource Brush.Link}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="Nieuwe weblink" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="Bewaar een pagina met een titel die jij herkent."
                                       Style="{StaticResource Text.Tiny}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Sluiten" />
                </Grid>
            </Border>

            <StackPanel Margin="26,4,26,0">
                <TextBlock Text="WEBADRES" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,6" />
                <TextBox x:Name="UrlBox" Height="42" LostFocus="UrlBox_LostFocus" TextChanged="UrlBox_TextChanged" />

                <Border Background="{DynamicResource Brush.LinkSoft}" CornerRadius="{DynamicResource Radius.M}"
                        Padding="12,8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Link}" Margin="0,0,7,0" />
                        <TextBlock x:Name="DomainPreview" Text="Alleen http- en https-adressen worden geopend."
                                   Style="{StaticResource Text.Tiny}" Foreground="{DynamicResource Brush.Link}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="TITEL" Style="{StaticResource Text.Eyebrow}" Margin="2,16,0,6" />
                <TextBox x:Name="TitleBox" Height="42" MaxLength="160" />

                <TextBlock Text="OMSCHRIJVING" Style="{StaticResource Text.Eyebrow}" Margin="2,16,0,6" />
                <TextBox x:Name="DescriptionBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="2000" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TAGS" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,6" />
                        <TextBox x:Name="TagsBox" Height="40" ToolTip="Gescheiden door komma's" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MAP" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,6" />
                        <Button x:Name="FolderButton" Style="{StaticResource Btn.Secondary}" Height="40"
                                HorizontalContentAlignment="Left" Click="Folder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="13"
                                           Foreground="{DynamicResource Brush.Sage}" Margin="0,0,8,0" />
                                <TextBlock x:Name="FolderLabel" Text="Geen map" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.M}"
                        Padding="13,9" Margin="0,16,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE735;" Style="{StaticResource Text.Icon}" FontSize="13"
                                       Foreground="{DynamicResource Brush.DarkYellow}" Margin="0,0,9,0" />
                            <TextBlock Text="Als favoriet bewaren" FontSize="12.5" />
                        </StackPanel>
                        <ToggleButton x:Name="FavoriteToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="2,12,2,0" Visibility="Collapsed" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,12"
                    Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Secondary}" Content="Annuleren" Click="Cancel_Click"
                            Margin="0,0,8,0" IsCancel="True" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Bewaren" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
