<UserControl x:Class="SaveSpace.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="PhotoCard" TargetType="Button">
            <Setter Property="Width" Value="264" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.L}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource Shadow.Soft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,24,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Afbeeldingen" Style="{StaticResource Text.H1}" />
                <TextBlock x:Name="SubtitleText" Text="Je foto's, groot en dichtbij. De originelen blijven ongemoeid."
                           Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Import_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="Foto's importeren" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}" Height="40" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,8,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Zoek op titel, tag of map…" Foreground="{DynamicResource Brush.Faint}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="12"
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>
            <Button x:Name="FolderFilterButton" Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="Alle mappen"
                    Margin="8,0,0,0" Click="FolderFilter_Click" />
            <Button x:Name="SortButton" Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Nieuwste eerst"
                    Click="Sort_Click" />
            <TextBlock Grid.Column="4" x:Name="CountLabel" Text="" Style="{StaticResource Text.Tiny}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PhotoList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PhotoCard}" Tag="{Binding}" Click="OpenPhoto_Click"
                                    ToolTip="{Binding Title}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="186" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.ImageSoft}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Border Background="{Binding Preview, Converter={StaticResource ImageBrush}}" />
                                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="34"
                                                       Foreground="{DynamicResource Brush.Image}"
                                                       Visibility="{Binding Preview, Converter={StaticResource NotNullToVis}}" />
                                            <Border VerticalAlignment="Bottom" Background="#66000000" Padding="10,5"
                                                    Visibility="{Binding Preview, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding SizeLabel}" Foreground="#FFF7ED" FontSize="10.5" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="5,9,4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.IconSmall}" Tag="{Binding}" Click="Favorite_Click"
                                                    ToolTip="Favoriet">
                                                <TextBlock Text="{Binding FavoriteGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="{DynamicResource Brush.DarkYellow}" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.IconSmall}" Tag="{Binding}" Click="Folder_Click"
                                                    ToolTip="In map plaatsen" Content="&#xE8B7;" FontSize="11" />
                                            <Button Style="{StaticResource Btn.IconSmall}" Tag="{Binding}" Click="Delete_Click"
                                                    ToolTip="Naar prullenbak" Content="&#xE74D;" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="440">
                <Border Width="78" Height="78" CornerRadius="{DynamicResource Radius.L}"
                        Background="{DynamicResource Brush.ImageSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="32"
                               Foreground="{DynamicResource Brush.Image}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="Nog geen foto's" Style="{StaticResource Text.H2}"
                           TextAlignment="Center" Margin="0,16,0,6" />
                <TextBlock x:Name="EmptyMessage"
                           Text="Importeer je eerste foto's. SaveSpace maakt miniaturen, bewaart een eigen kopie en laat je originele bestanden staan."
                           Style="{StaticResource Text.Small}" TextAlignment="Center" />
                <Button Style="{StaticResource Btn.Primary}" Content="Foto's importeren" Click="Import_Click"
                        Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
