<UserControl x:Class="SaveSpace.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="EditorTitle" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.DisplayFamily}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Tiny}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="220" />
        </Style>
        <Style x:Key="WorkspaceTabButton" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Pill}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="SubtitleText" Visibility="Collapsed" />
        <Grid Margin="{DynamicResource Spacing.Notes}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Content -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Notes list -->
                <Border Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,7">
                            <Grid Margin="2,0,2,9">
                                <TextBlock Text="Alle notities" FontWeight="SemiBold" FontSize="12.5" />
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Pill}"
                                        Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="NoteCount" Text="0" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                                </Border>
                            </Grid>
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.M}" Padding="10,0" Height="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,7,0" />
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="Zoek in notities…" Foreground="{DynamicResource Brush.Faint}"
                                                   FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NoteSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="NoteSearch" Style="{StaticResource Input.Search}" FontSize="11.5"
                                                 VerticalAlignment="Center" TextChanged="NoteSearch_TextChanged" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="NotesList" Margin="7,0,7,9" SelectionChanged="NotesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource Radius.M}" Background="{Binding TintBrush}"
                                                Padding="{DynamicResource Layout.RowPadding}" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" CornerRadius="2" Background="{Binding StripBrush}"
                                                    Margin="0,2,0,2" />
                                            <StackPanel Grid.Column="1" Margin="9,0,7,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.2"
                                                           Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                           Foreground="{DynamicResource Brush.Faint}" Margin="0,2,0,0" FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FavoriteGlyph}" Style="{StaticResource Text.Icon}"
                                                       FontSize="10" Foreground="{DynamicResource Brush.DarkYellow}"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoNotesHint" Text="Nog geen notities.&#10;Maak je eerste notitie met de knop rechtsboven."
                                       Style="{StaticResource Text.Small}" TextAlignment="Center" VerticalAlignment="Center"
                                       Margin="24" Visibility="Collapsed" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Editor + workspace -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="330" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="WorkspaceColumn" Width="Auto" MinWidth="340" MaxWidth="760" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="EditorContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Margin="22,15,14,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource EditorTitle}" TextChanged="TitleBox_TextChanged"
                                             VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button x:Name="HistoryButton" Style="{StaticResource Btn.IconSmall}" Click="History_Click"
                                                ToolTip="Vorige versies van deze notitie" Content="&#xE81C;" />
                                        <Button x:Name="FavButton" Style="{StaticResource Btn.IconSmall}" Click="Favorite_Click"
                                                ToolTip="Favoriet" Content="&#xE734;" />
                                        <Button x:Name="DeleteButton" Style="{StaticResource Btn.IconSmall}" Click="Delete_Click"
                                                ToolTip="Naar prullenbak" Content="&#xE74D;" />
                                    </StackPanel>
                                </Grid>

                                <!-- Toolbar -->
                                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,1"
                                        Padding="10,4" Background="{DynamicResource Brush.Surface}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Bold_Click" Focusable="False" ToolTip="Vet (Ctrl+B)">
                                                    <TextBlock Text="B" FontWeight="Bold" FontSize="12.5" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Italic_Click" Focusable="False" ToolTip="Cursief (Ctrl+I)">
                                                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="13.5" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Underline_Click" Focusable="False" ToolTip="Onderstreept (Ctrl+U)">
                                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="12.5" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Strike_Click" Focusable="False" ToolTip="Doorhalen">
                                                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="12.5" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="TextColor_Click" Focusable="False" ToolTip="Tekstkleur">
                                                    <StackPanel>
                                                        <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <Border Height="2.5" Width="12" Background="{DynamicResource Brush.Accent}"
                                                                CornerRadius="1" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="FontSize_Click" Focusable="False" ToolTip="Tekengrootte">
                                                    <TextBlock Text="Aa" FontSize="11" />
                                                </Button>
                                                <Border Width="1" Height="17" Background="{DynamicResource Brush.Line}" Margin="5,0" />
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Bullets_Click" Focusable="False" ToolTip="Lijst">
                                                    <TextBlock Text="•" FontSize="16" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Numbers_Click" Focusable="False" ToolTip="Genummerde lijst">
                                                    <TextBlock Text="1." FontSize="11.5" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Checklist_Click" Focusable="False" ToolTip="Checklist">
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                                </Button>
                                                <Border Width="1" Height="17" Background="{DynamicResource Brush.Line}" Margin="5,0" />
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Heading_Click" Focusable="False" ToolTip="Grote kop">
                                                    <TextBlock Text="H1" FontWeight="Bold" FontSize="11" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Subheading_Click" Focusable="False" ToolTip="Kleine kop">
                                                    <TextBlock Text="H2" FontWeight="Bold" FontSize="11" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Body_Click" Focusable="False" ToolTip="Normale tekst">
                                                    <TextBlock Text="¶" FontSize="14" />
                                                </Button>
                                                <Border Width="1" Height="17" Background="{DynamicResource Brush.Line}" Margin="5,0" />
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Link_Click" Focusable="False" ToolTip="Koppeling invoegen">
                                                    <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Insert_Click" Focusable="False" ToolTip="Invoegen">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Undo_Click" Focusable="False" ToolTip="Ongedaan maken">
                                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Toolbar}" Click="Redo_Click" Focusable="False" ToolTip="Opnieuw">
                                                    <TextBlock Text="&#xE7A6;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Button x:Name="FolderButton" Style="{StaticResource Btn.Toolbar}" Click="Folder_Click"
                                                    Focusable="False" ToolTip="In project plaatsen">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="11"
                                                               Foreground="{DynamicResource Brush.Sage}" Margin="0,0,4,0" />
                                                    <TextBlock x:Name="FolderLabel" Text="Geen project" FontSize="10.5" MaxWidth="90"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiButton" Style="{StaticResource Btn.Toolbar}" Click="Ai_Click" Focusable="False" ToolTip="AI-assistent">
                                                <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.Toolbar}" Click="BrowserWorkspace_Click" Focusable="False" ToolTip="Webbrowser openen">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Muted}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="22,15,22,12"
                                                 AllowDrop="True" DragOver="Editor_DragOver" Drop="Editor_Drop"
                                                 FontFamily="{DynamicResource Font.BodyFamily}" FontSize="14.5" Foreground="{DynamicResource Brush.Ink}"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 AcceptsTab="True" SpellCheck.IsEnabled="True" TextChanged="Editor_TextChanged"
                                                 PreviewKeyDown="Editor_PreviewKeyDown">
                                        <RichTextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Knippen" Command="{x:Static ApplicationCommands.Cut}"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          InputGestureText="Ctrl+X" />
                                                <MenuItem Header="Kopiëren" Command="{x:Static ApplicationCommands.Copy}"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          InputGestureText="Ctrl+C" />
                                                <MenuItem Header="Plakken" Command="{x:Static ApplicationCommands.Paste}"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          InputGestureText="Ctrl+V" />
                                                <Separator />
                                                <MenuItem Header="Ongedaan maken" Command="{x:Static ApplicationCommands.Undo}"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          InputGestureText="Ctrl+Z" />
                                                <MenuItem Header="Opnieuw" Command="{x:Static ApplicationCommands.Redo}"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          InputGestureText="Ctrl+Y" />
                                            </ContextMenu>
                                        </RichTextBox.ContextMenu>
                                    </RichTextBox>
                                    <Border x:Name="EditorEmptyHint" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                            <TextBlock Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="32"
                                                       Foreground="{DynamicResource Brush.Faint}" />
                                            <TextBlock Text="Kies een notitie of begin een nieuwe." Style="{StaticResource Text.H3}"
                                                       TextAlignment="Center" Margin="0,11,0,4" />
                                            <TextBlock Text="Je woorden worden vanzelf bewaard terwijl je schrijft."
                                                       Style="{StaticResource Text.Small}" TextAlignment="Center" />
                                            <Button Style="{StaticResource Btn.Primary}" Content="Nieuwe notitie" Click="NewNote_Click"
                                                    Margin="0,13,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="AttachmentBar" Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                                        Padding="14,8" AllowDrop="True" DragOver="Attachments_DragOver" Drop="Attachments_Drop"
                                        Background="{DynamicResource Brush.SurfaceAlt}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Bijlagen" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="AttachmentCount" Text="" Style="{StaticResource Text.Tiny}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Style="{StaticResource Btn.Secondary}" Content="+ Bijlage toevoegen" Click="AddAttachment_Click" Padding="10,4" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0,0,0">
                                            <StackPanel x:Name="AttachmentList" Orientation="Horizontal" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Text.Icon}" FontSize="10"
                                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,0,6,0" />
                                            <TextBox x:Name="TagsBox" Style="{StaticResource TagInput}" TextChanged="TagsBox_TextChanged"
                                                     ToolTip="Tags, gescheiden door komma's" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="WordCount" Text="0 woorden" Style="{StaticResource Text.Tiny}" Margin="0,0,12,0" />
                                            <Ellipse x:Name="SaveDot" Width="6" Height="6" Fill="{DynamicResource Brush.Success}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock x:Name="SaveStatus" Text="Opgeslagen: zojuist" Style="{StaticResource Text.Tiny}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="EmptyPanel" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                    <Border Width="60" Height="60" CornerRadius="{DynamicResource Radius.L}"
                                            Background="{DynamicResource Brush.NoteSoft}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="24"
                                                   Foreground="{DynamicResource Brush.Note}" />
                                    </Border>
                                    <TextBlock Text="Nog geen notities" Style="{StaticResource Text.H2}" TextAlignment="Center" Margin="0,14,0,5" />
                                    <TextBlock Text="Begin met een gedachte, een lijst of een lang verhaal. SaveSpace bewaart het automatisch."
                                               Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource Btn.Primary}" Content="Eerste notitie schrijven" Click="NewNote_Click"
                                            Margin="0,14,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="14" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="{DynamicResource Brush.Line}" Opacity="0.7" ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Visibility="Collapsed"
                                  DragCompleted="WorkspaceSplitter_DragCompleted" Cursor="SizeWE" />

                    <!-- Right workspace -->
                    <Border x:Name="WorkspaceShell" Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.L}" ClipToBounds="True" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="0,0,0,1" Padding="5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  VerticalAlignment="Center">
                                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" AllowDrop="True"
                                                    DragOver="TabStrip_DragOver" Drop="TabStrip_Drop" />
                                    </ScrollViewer>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                                        <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE710;" Click="AddTab_Click"
                                                ToolTip="Nieuw tabblad" Width="26" Height="26" />
                                        <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" Click="HideWorkspace_Click"
                                                ToolTip="Werkruimte verbergen" Width="26" Height="26" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid x:Name="WorkspaceContent" />
                                <Border x:Name="WorkspaceEmpty" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250" Margin="20">
                                        <Border Width="42" Height="42" CornerRadius="{DynamicResource Radius.M}"
                                                Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="18"
                                                       Foreground="{DynamicResource Brush.Faint}" />
                                        </Border>
                                        <TextBlock Text="Je werkruimte is leeg" Style="{StaticResource Text.H3}"
                                                   TextAlignment="Center" Margin="0,11,0,4" />
                                        <TextBlock Text="Open een browsertab, de AI-assistent of een document naast je notitie."
                                                   Style="{StaticResource Text.Tiny}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource Btn.Secondary}" Content="Tabblad toevoegen" Click="AddTab_Click"
                                                HorizontalAlignment="Center" Margin="0,11,0,0" FontSize="10.5" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Popup x:Name="AiPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AiButton}" VerticalOffset="8"
               HorizontalOffset="-120" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="9" Width="286"
                    Effect="{DynamicResource Shadow.Hover}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="11,7,11,8">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="AI-ASSISTENT" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Menu}" Click="AiSummarize_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.Link}" />
                            <TextBlock Text="Samenvatten" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="AiImprove_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.Amber}" />
                            <TextBlock Text="Helderder herschrijven" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="AiTitle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AC;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.Video}" />
                            <TextBlock Text="Titel voorstellen" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="AiContinue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.Sage}" />
                            <TextBlock Text="Verder schrijven" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="8,5" />
                    <Button Style="{StaticResource Btn.Menu}" Click="OpenAiWorkspace_Click">
                        <StackPanel Orientation="Horizontal">
