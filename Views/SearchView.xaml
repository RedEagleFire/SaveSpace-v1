<UserControl x:Class="SaveSpace.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ZOEKEN" Style="{StaticResource Text.Eyebrow}" FontSize="10" />
            <TextBlock Text="Alles terugvinden" Style="{StaticResource Text.H1}" Margin="0,3,0,0" />
            <TextBlock x:Name="SubtitleText" Text="Zoek in notities, inhoud, tags, bestandsnamen en projecten."
                       Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Height="46" Padding="14,0"
                Margin="0,16,0,10" MaxWidth="760" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="15"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                <Grid Grid.Column="1">
                    <TextBlock Text="Zoek een notitie, project of bestand…" Foreground="{DynamicResource Brush.Faint}"
                               VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="QueryBox" Style="{StaticResource Input.Search}" FontSize="13"
                             TextChanged="QueryBox_TextChanged" />
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" Click="Clear_Click"
                        ToolTip="Wissen" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,12">
            <ToggleButton x:Name="FilterAll" Style="{StaticResource FilterChip}" Content="Alles" IsChecked="True" Click="Filter_Click" Tag="all" />
            <ToggleButton x:Name="FilterNotes" Style="{StaticResource FilterChip}" Content="Notities" Click="Filter_Click" Tag="notes" />
            <ToggleButton x:Name="FilterFiles" Style="{StaticResource FilterChip}" Content="Bestanden" Click="Filter_Click" Tag="files" />
            <ToggleButton x:Name="FilterLinks" Style="{StaticResource FilterChip}" Content="Weblinks" Click="Filter_Click" Tag="links" />
            <ToggleButton x:Name="FilterProjects" Style="{StaticResource FilterChip}" Content="Projecten" Click="Filter_Click" Tag="projects" />
            <TextBlock x:Name="CountText" Text="" Style="{StaticResource Text.Tiny}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ProjectsSection">
                    <TextBlock Text="PROJECTEN" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" Margin="2,0,0,7" />
                    <ItemsControl x:Name="ProjectsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Ghost}" Tag="{Binding}" Click="Project_Click"
                                        HorizontalContentAlignment="Stretch" Padding="10,7" Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="{DynamicResource Radius.S}"
                                                Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="11"
                                                       Foreground="{Binding ColorBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource Text.Tiny}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ResultsSection">
                    <TextBlock Text="RESULTATEN" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" Margin="2,10,0,7" />
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Margin="0,0,0,5"
                                        MouseLeftButtonUp="Result_MouseLeftButtonUp" Cursor="Hand" Tag="{Binding}">
                                    <Grid Margin="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.S}"
                                                Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,11,0">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="14"
                                                       Foreground="{Binding AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource Brush.Faint}" />
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Text.Tiny}" FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                   Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border x:Name="EmptyPanel" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Padding="30,26" Margin="0,6,0,0">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="46" Height="46" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.SurfaceAlt}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyIcon" Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="19"
                                       Foreground="{DynamicResource Brush.Faint}" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="Typ om te zoeken" Style="{StaticResource Text.H2}"
                                   TextAlignment="Center" Margin="0,14,0,5" />
                        <TextBlock x:Name="EmptyText" Text="Doorzoek titels, notitie-inhoud, tags, weblinks, bestandsnamen en projecten. Resultaten verschijnen direct."
                                   Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
