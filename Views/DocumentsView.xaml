<UserControl x:Class="SaveSpace.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
        <Style x:Key="DocRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="EyebrowText" Text="DOCUMENTEN" Style="{StaticResource Text.Eyebrow}" FontSize="10" />
                <TextBlock x:Name="HeadingText" Text="Documenten" Style="{StaticResource Text.H1}" Margin="0,3,0,0" />
                <TextBlock x:Name="SubtitleText" Text="PDF's, tekst en Office-bestanden, lokaal bewaard."
                           Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Secondary}" Click="OpenFolder_Click" Margin="0,0,7,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Opslagmap" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Click="Import_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock x:Name="ImportButtonLabel" Text="Document toevoegen" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="FilterAll" Style="{StaticResource FilterChip}" Content="Alles" IsChecked="True"
                              Click="Filter_Click" Tag="all" />
                <ToggleButton x:Name="FilterPdf" Style="{StaticResource FilterChip}" Content="PDF" Click="Filter_Click" Tag="pdf" />
                <ToggleButton x:Name="FilterOffice" Style="{StaticResource FilterChip}" Content="Office" Click="Filter_Click" Tag="office" />
                <ToggleButton x:Name="FilterText" Style="{StaticResource FilterChip}" Content="Tekst" Click="Filter_Click" Tag="text" />
                <ToggleButton x:Name="FilterMedia" Style="{StaticResource FilterChip}" Content="Media" Click="Filter_Click" Tag="media" />
                <ToggleButton x:Name="FilterAudio" Style="{StaticResource FilterChip}" Content="Muziek" Click="Filter_Click" Tag="audio" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}" Height="32" Padding="11,0"
                    MaxWidth="300" HorizontalAlignment="Right" Margin="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="11"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,7,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Zoek op naam…" Foreground="{DynamicResource Brush.Faint}" FontSize="11.5"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="11.5"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Column="2" x:Name="CountText" Text="" Style="{StaticResource Text.Tiny}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DocsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Margin="0,0,0,5"
                                    MouseLeftButtonUp="Doc_MouseLeftButtonUp" MouseRightButtonUp="Doc_MouseRightButtonUp"
                                    Cursor="Hand" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Openen" Click="MenuOpen_Click" Tag="{Binding}" />
                                        <MenuItem Header="Extern openen" Click="MenuExternal_Click" Tag="{Binding}" />
                                        <MenuItem Header="Map openen" Click="MenuFolder_Click" Tag="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Favoriet aan/uit" Click="MenuFavorite_Click" Tag="{Binding}" />
                                        <MenuItem Header="Naar prullenbak" Click="MenuTrash_Click" Tag="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.S}"
                                            Background="{DynamicResource Brush.DocumentSoft}" Margin="0,0,11,0">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="16"
                                                   Foreground="{DynamicResource Brush.Document}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding ExtensionLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Document}" />
                                            <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource Brush.Faint}" />
                                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Text.Tiny}" FontSize="10" />
                                            <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource Brush.Faint}"
                                                       Visibility="{Binding FolderName, Converter={StaticResource NotNullToVis}}" />
                                            <TextBlock Text="{Binding FolderName}" Style="{StaticResource Text.Tiny}" FontSize="10"
                                                       Visibility="{Binding FolderName, Converter={StaticResource NotNullToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                               Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="3" Style="{StaticResource Btn.IconSmall}" Content="{Binding FavoriteGlyph}"
                                            Foreground="{DynamicResource Brush.DarkYellow}" Tag="{Binding}" Click="Fav_Click"
                                            ToolTip="Favoriet" />
                                    <Button Grid.Column="4" Style="{StaticResource Btn.IconSmall}" Content="&#xE76C;"
                                            Tag="{Binding}" Click="Open_Click" ToolTip="Openen" Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}"
                    Padding="30,26">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <Border Width="52" Height="52" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.DocumentSoft}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="22"
                                   Foreground="{DynamicResource Brush.Document}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Nog geen documenten" Style="{StaticResource Text.H2}"
                               TextAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock x:Name="EmptyText" Text="Voeg een pdf, Word-bestand of tekst toe. SaveSpace maakt een veilige kopie en laat je origineel staan."
                               Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Document toevoegen" Click="Import_Click"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
