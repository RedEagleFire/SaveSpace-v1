<UserControl x:Class="SaveSpace.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>

        <Style x:Key="ProjectCard" TargetType="Button">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="14,13">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryCard" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="HomeWidgetCard" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Width" Value="184" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="NoteCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="13,11">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="SegButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Border Background="{DynamicResource Brush.HomeBackground}" IsHitTestVisible="False" />
        <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="{DynamicResource Home.WaveOpacity}">
            <Canvas Width="1600" Height="1000" ClipToBounds="True">
                <Ellipse Width="860" Height="500" Canvas.Left="360" Canvas.Top="-350"
                         Fill="{DynamicResource Brush.HomeGlow}" Opacity="0.8">
                    <Ellipse.Effect><BlurEffect Radius="58" /></Ellipse.Effect>
                </Ellipse>
                <Path Data="M-110,710 C170,653 400,587 665,618 C936,650 1135,831 1710,556"
                      Stroke="{DynamicResource Brush.HomeWave}" StrokeThickness="122" Opacity="0.18"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="62" /></Path.Effect>
                </Path>
                <Path Data="M-110,710 C170,653 400,587 665,618 C936,650 1135,831 1710,556"
                      Stroke="{DynamicResource Brush.HomeWave}" StrokeThickness="27" Opacity="0.26"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="18" /></Path.Effect>
                </Path>
                <Path Data="M-110,710 C170,653 400,587 665,618 C936,650 1135,831 1710,556"
                      Stroke="{DynamicResource Brush.HomeWave}" StrokeThickness="1.4" Opacity="0.58"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M-140,930 C225,865 440,735 755,778 C1075,822 1320,1000 1715,740"
                      Stroke="{DynamicResource Brush.HomeWave}" StrokeThickness="72" Opacity="0.11"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Effect><BlurEffect Radius="42" /></Path.Effect>
                </Path>
            </Canvas>
        </Viewbox>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,26" MaxWidth="1460" HorizontalAlignment="Stretch">
            <!-- Kop -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DateText" Text="DINSDAG 25 NOVEMBER" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="GreetingText" Text="Goedemiddag" Style="{StaticResource Text.H1}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="SummaryText" Text="" Style="{StaticResource Text.Small}" />
                        <TextBlock Text="  ·  " Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.Faint}" />
                        <TextBlock x:Name="SaveSummary" Text="Opgeslagen: zojuist" Style="{StaticResource Text.Small}"
                                   Foreground="{DynamicResource Brush.Faint}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Primary}" Click="NewNote_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Nieuwe notitie" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Secondary}" Click="NewProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0"
                                       Foreground="{DynamicResource Brush.Folder}" />
                            <TextBlock Text="Nieuw project" />
                        </StackPanel>
                    </Button>
                </StackPanel>
        </Grid>
                    <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="272" />
                </Grid.ColumnDefinitions>

                <!-- Hoofdkolom -->
                <StackPanel Grid.Column="0">
                    <!-- Projecten -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="PROJECTEN" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Alle projecten  →" HorizontalAlignment="Right"
                                Click="AllProjects_Click" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ProjectsPanel" Orientation="Horizontal" Margin="0,0,0,2" />
                    </ScrollViewer>

                    <!-- Bibliotheekonderdelen: de oude vaste categoriebalk is vervangen door dit Home-blok. -->
                    <Grid Margin="0,18,0,10">
                        <TextBlock Text="BIBLIOTHEEK" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="Open een verzameling" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" />
                    </Grid>
                    <WrapPanel>
                        <Button Style="{StaticResource LibraryCard}" Tag="Documents" Click="LibraryCategory_Click" ToolTip="Alle losse documenten">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Documenten" FontWeight="SemiBold" FontSize="11.5" /><TextBlock Text="Word, PDF en meer" Style="{StaticResource Text.Tiny}" FontSize="9.5" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LibraryCard}" Tag="Audio" Click="LibraryCategory_Click" ToolTip="Alle losse muziekbestanden">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Muziek" FontWeight="SemiBold" FontSize="11.5" /><TextBlock Text="Audio" Style="{StaticResource Text.Tiny}" FontSize="9.5" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LibraryCard}" Tag="Images" Click="LibraryCategory_Click" ToolTip="Alle losse afbeeldingen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Afbeeldingen" FontWeight="SemiBold" FontSize="11.5" /><TextBlock Text="Foto's en illustraties" Style="{StaticResource Text.Tiny}" FontSize="9.5" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LibraryCard}" Tag="Videos" Click="LibraryCategory_Click" ToolTip="Alle losse video's">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Video's" FontWeight="SemiBold" FontSize="11.5" /><TextBlock Text="Films en clips" Style="{StaticResource Text.Tiny}" FontSize="9.5" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LibraryCard}" Tag="Trash" Click="LibraryCategory_Click" ToolTip="Verwijderde items herstellen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Prullenbak" FontWeight="SemiBold" FontSize="11.5" /><TextBlock Text="Herstellen of wissen" Style="{StaticResource Text.Tiny}" FontSize="9.5" /></StackPanel>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Recente notities -->
                    <Grid Margin="0,22,0,10">
                        <TextBlock Text="LAATST BEWERKT" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Alle notities  →" HorizontalAlignment="Right"
                                Click="AllNotes_Click" />
                    </Grid>
                    <ItemsControl x:Name="RecentNotesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NoteCard}" Tag="{Binding}" Click="RecentNote_Click" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="{DynamicResource Radius.S}"
                                                    Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,8,0">
                                                <TextBlock Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding FavoriteGlyph}" Style="{StaticResource Text.Icon}"
                                                       FontSize="10" Foreground="{DynamicResource Brush.DarkYellow}" Margin="6,0,0,0"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,9,0,9" MaxHeight="34" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                   Foreground="{DynamicResource Brush.Faint}" FontSize="10" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="NotesEmpty" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.L}" Padding="18,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nog geen notities." Style="{StaticResource Text.Small}" />
                            <Button Style="{StaticResource LinkButton}" Content="Schrijf de eerste  →" Click="NewNote_Click"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Recente bestanden -->
                    <Grid Margin="0,22,0,10">
                        <TextBlock Text="RECENTE BESTANDEN" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource LinkButton}" Content="Alles  →" Click="AllFiles_Click" Margin="0,0,7,0" />
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.S}" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="CardsToggle" Style="{StaticResource SegButton}" Content="&#xE80A;"
                                                  ToolTip="Kaarten" Click="CardsToggle_Click" IsChecked="True" />
                                    <ToggleButton x:Name="ListToggle" Style="{StaticResource SegButton}" Content="&#xEA37;"
                                                  ToolTip="Lijst" Click="ListToggle_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="6">
                        <Grid>
                            <ItemsControl x:Name="RecentCardsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NoteCard}" Tag="{Binding}" Click="RecentFile_Click" Margin="3"
                                                ToolTip="{Binding Title}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="74" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.SurfaceAlt}"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                        <TextBlock Text="{Binding Icon}" FontSize="24"
                                                                   Foreground="{Binding AccentBrush}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Background="#66000000" CornerRadius="{DynamicResource Radius.S}" Padding="6,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="9" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,8,0,2">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                               Foreground="{DynamicResource Brush.Faint}" Margin="0,2,0,0" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="RecentRowsList" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="RecentFile_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="{DynamicResource Radius.S}"
                                                        Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="12"
                                                               Foreground="{Binding AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Tiny}"
                                                               TextTrimming="CharacterEllipsis" FontSize="10" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Text.Tiny}"
                                                           Foreground="{DynamicResource Brush.Faint}" Margin="12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                           Foreground="{DynamicResource Brush.Faint}" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="FilesEmpty" Text="Nog geen bestanden. Sleep of importeer een document, foto of video."
                                       Style="{StaticResource Text.Small}" Margin="14,16" TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Zijkolom -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="VERDER" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Snel iets toevoegen" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="Alles blijft lokaal, tenzij je zelf de AI gebruikt." Style="{StaticResource Text.Tiny}"
                                       TextWrapping="Wrap" Margin="0,3,0,9" />
                            <Button Style="{StaticResource Btn.Ghost}" Click="NewNote_Click" HorizontalContentAlignment="Left"
                                    Padding="8,6" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="Notitie" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Click="NewDocument_Click" HorizontalContentAlignment="Left"
                                    Padding="8,6" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Document}" Margin="0,0,8,0" />
                                    <TextBlock Text="Document toevoegen" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Click="NewImage_Click" HorizontalContentAlignment="Left"
                                    Padding="8,6" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Image}" Margin="0,0,8,0" />
                                    <TextBlock Text="Foto's importeren" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Click="NewVideo_Click" HorizontalContentAlignment="Left"
                                    Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Video}" Margin="0,0,8,0" />
                                    <TextBlock Text="Video importeren" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" BorderBrush="{DynamicResource Brush.AccentBorder}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.L}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="14"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" />
                                <TextBlock Text="AI-assistent" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Vat een notitie samen, herschrijf een alinea of stel vragen over je documenten."
                                       Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" Margin="0,5,0,9" LineHeight="16" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Open assistent" Click="Ai_Click"
                                    HorizontalAlignment="Left" FontSize="11" Padding="10,5" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Opslag" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="StorageUsed" Text="0 MB" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Muted}" />
                            </Grid>
                            <ProgressBar x:Name="StorageBar" Value="0" Maximum="100" Margin="0,9,0,6" />
                            <TextBlock x:Name="StorageDetail" Text="" Style="{StaticResource Text.Tiny}" FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Style="{StaticResource Btn.Secondary}" Content="Map openen" Click="OpenStorage_Click"
                                        FontSize="10.5" Padding="9,4" Margin="0,0,5,0" />
                                <Button Style="{StaticResource Btn.Ghost}" Content="Back-up" Click="Backup_Click"
                                        FontSize="10.5" Padding="8,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border x:Name="WidgetsPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{DynamicResource Radius.L}"
                    Padding="14,12" Margin="0,20,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="JOUW OVERZICHT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Widgets" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="Aanpassen in instellingen  →"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenWidgetSettings_Click" />
                    </Grid>
                    <ItemsControl x:Name="HomeWidgetsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HomeWidgetCard}" Tag="{Binding Key}" Click="HomeWidget_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="{DynamicResource Radius.S}"
                                                Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="14"
                                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Tiny}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
