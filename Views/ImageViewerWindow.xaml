<Window x:Class="SaveSpace.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afbeelding" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Canvas}" ShowInTaskbar="True" FontFamily="{DynamicResource Font.BodyFamily}"
        Foreground="{DynamicResource Brush.Ink}" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ViewerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.M}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerIcon" TargetType="Button" BasedOn="{StaticResource ViewerButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ViewerButton}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                Padding="22,13" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,12,0">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   MaxWidth="680" />
                        <TextBlock x:Name="CounterText" FontSize="10.5" Foreground="#9C9186" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="FavoriteButton" Style="{StaticResource ViewerButton}" Click="Favorite_Click"
                            Margin="0,0,7,0" ToolTip="Favoriet (F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" />
                            <TextBlock x:Name="FavoriteLabel" Text="Favoriet" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="Annotate_Click" Margin="0,0,7,0"
                            ToolTip="Markeer deze afbeelding als een nieuwe kopie">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="Markeren" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OpenExternal_Click" Margin="0,0,7,0"
                            ToolTip="Openen met de standaard-app">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Openen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE838;" Click="Reveal_Click"
                            ToolTip="Toon in Verkenner" Margin="0,0,7,0" />
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE74D;" Click="Delete_Click"
                            ToolTip="Naar prullenbak (Delete)" Margin="0,0,12,0" />
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Sluiten (Esc)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}" ClipToBounds="True">
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both" Background="Transparent">
                <Grid x:Name="ImageStage" Margin="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="Photo" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                           MouseWheel="Photo_MouseWheel" MouseLeftButtonDown="Photo_MouseLeftButtonDown"
                           MouseLeftButtonUp="Photo_MouseLeftButtonUp" MouseMove="Photo_MouseMove"
                           Cursor="Hand" />
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                        MaxWidth="440">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="38"
                           Foreground="#F06A5C" HorizontalAlignment="Center" />
                <TextBlock Text="De afbeelding kan niet worden geopend" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,14,0,6" />
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#9C9186" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Style="{StaticResource ViewerButton}" Content="Toon in Verkenner" Click="Reveal_Click"
                        HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>

            <Button x:Name="PrevButton" Style="{StaticResource NavButton}" Content="&#xE76B;" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="18,0" Click="Prev_Click" ToolTip="Vorige (←)" />
            <Button x:Name="NextButton" Style="{StaticResource NavButton}" Content="&#xE76C;" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="18,0" Click="Next_Click" ToolTip="Volgende (→)" />
        </Grid>

        <Border Grid.Row="2" Background="#D90C0B0A" Padding="22,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="InfoText" FontSize="10.5" Foreground="#9C9186" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Uitzoomen (−)" />
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="11.5" Width="58" TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Inzoomen (+)" />
                    <Border Width="1" Height="20" Background="#26FFFFFF" Margin="10,0" />
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE7A8;" Click="RotateLeft_Click" ToolTip="Links draaien" />
                    <Button Style="{StaticResource ViewerIcon}" Content="&#xE7AD;" Click="RotateRight_Click" ToolTip="Rechts draaien" />
                    <Border Width="1" Height="20" Background="#26FFFFFF" Margin="10,0" />
                    <Button Style="{StaticResource ViewerButton}" Content="Passend maken" Click="Fit_Click" />
                </StackPanel>

                <TextBlock Text="Scroll om te zoomen · sleep om te verschuiven" FontSize="10.5" Foreground="#6E655B"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
