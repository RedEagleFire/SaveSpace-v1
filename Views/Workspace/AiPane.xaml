<UserControl x:Class="SaveSpace.Views.Workspace.AiPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Surface}">
    <UserControl.Resources>
        <Style x:Key="AiChip" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="12"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" />
                    <TextBlock x:Name="ModelText" Text="AI-assistent" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText" Text="" Style="{StaticResource Text.Tiny}" FontSize="9.5"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE713;" Click="Settings_Click"
                            ToolTip="AI-instellingen" Width="24" Height="24" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="0,6,0,6">
                <StackPanel x:Name="MessagesPanel" />
            </ScrollViewer>
            <Border x:Name="EmptyPanel" Background="{DynamicResource Brush.Surface}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270" Margin="22">
                    <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="17"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Vraag over deze notitie" Style="{StaticResource Text.H3}"
                               TextAlignment="Center" Margin="0,11,0,4" />
                    <TextBlock x:Name="EmptyText" Text="De assistent leest alleen de notitie die je nu open hebt. Je ziet eerst elk voorstel voordat er iets verandert."
                               Style="{StaticResource Text.Tiny}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="15" />
                </StackPanel>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="10,4,6,0">
            <Button Style="{StaticResource AiChip}" Content="Vat samen" Click="Summarize_Click" />
            <Button Style="{StaticResource AiChip}" Content="Herschrijf" Click="Improve_Click" />
            <Button Style="{StaticResource AiChip}" Content="Titel" Click="Title_Click" />
            <Button Style="{StaticResource AiChip}" Content="Verder" Click="Continue_Click" />
        </WrapPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,10,12,11"
                Background="{DynamicResource Brush.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.LineStrong}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="12,8">
                    <Grid MinHeight="52">
                        <TextBlock Text="Vraag iets over deze notitie…" Foreground="{DynamicResource Brush.Faint}"
                                   FontSize="12" Margin="2,2,2,0" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="InputBox" Style="{StaticResource Input.Search}" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" KeyDown="Input_KeyDown" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Tiny}" FontSize="9.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StopButton" Style="{StaticResource Btn.Ghost}" Content="Stop" Click="Stop_Click"
                                FontSize="10" Padding="9,4" Margin="0,0,5,0" Visibility="Collapsed" />
                        <Button x:Name="SendButton" Style="{StaticResource Btn.Primary}" Click="Send_Click"
                                FontSize="10" Padding="11,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE724;" Style="{StaticResource Text.Icon}" FontSize="10" Margin="0,0,5,0" />
                                <TextBlock Text="Stuur" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
