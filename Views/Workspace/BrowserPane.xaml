<UserControl x:Class="SaveSpace.Views.Workspace.BrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" Padding="5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Style="{StaticResource Btn.IconSmall}" Content="&#xE72B;"
                        Click="Back_Click" ToolTip="Terug" IsEnabled="False" Width="27" Height="27" />
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource Btn.IconSmall}" Content="&#xE72A;"
                        Click="Forward_Click" ToolTip="Vooruit" IsEnabled="False" Width="27" Height="27" />
                <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource Btn.IconSmall}" Content="&#xE72C;"
                        Click="Reload_Click" ToolTip="Herladen" Width="27" Height="27" Margin="0,0,4,0" />

                <Border Grid.Column="3" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Pill}" Height="28" Padding="9,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SchemeIcon" Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,0,6,0" />
                        <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource Input.Search}" FontSize="11"
                                 VerticalAlignment="Center" KeyDown="Address_KeyDown"
                                 GotKeyboardFocus="Address_GotKeyboardFocus" LostKeyboardFocus="Address_LostKeyboardFocus" />
                    </Grid>
                </Border>

                <Button x:Name="FavoriteButton" Grid.Column="4" Style="{StaticResource Btn.IconSmall}" Content="&#xE734;"
                        Click="Favorite_Click" ToolTip="Favoriet" Width="27" Height="27" Margin="3,0,0,0"
                        Foreground="{DynamicResource Brush.DarkYellow}" />
                <Button x:Name="HistoryButton" Grid.Column="5" Style="{StaticResource Btn.IconSmall}" Content="&#xE81C;"
                        Click="History_Click" ToolTip="Geschiedenis" Width="27" Height="27" />
                <Button x:Name="MenuButton" Grid.Column="6" Style="{StaticResource Btn.IconSmall}" Content="&#xE712;"
                        Click="Menu_Click" ToolTip="Browsermenu" Width="27" Height="27" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

            <Border x:Name="LoadingPanel" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{DynamicResource Brush.Accent}"
                                 Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="0" />
                    <TextBlock x:Name="LoadingText" Text="Pagina laden…" Style="{StaticResource Text.Tiny}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="FallbackPanel" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="24">
                    <Border Width="44" Height="44" CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="19"
                                   Foreground="{DynamicResource Brush.Faint}" />
                    </Border>
                    <TextBlock x:Name="FallbackTitle" Text="Browser niet beschikbaar" Style="{StaticResource Text.H3}"
                               TextAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock x:Name="FallbackText" Text="" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
                        <Button Style="{StaticResource Btn.Secondary}" Content="Extern openen" Click="OpenExternal_Click"
                                FontSize="10.5" Margin="0,0,6,0" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Opnieuw" Click="Retry_Click" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
