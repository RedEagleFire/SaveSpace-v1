<UserControl x:Class="SaveSpace.Views.Workspace.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="KindIcon" Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="12"
                           Foreground="{DynamicResource Brush.Document}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="" FontSize="11" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Btn.IconSmall}" Content="&#xE71F;" Click="ZoomOut_Click"
                        ToolTip="Uitzoomen" Width="25" Height="25" />
                <Button Grid.Column="3" Style="{StaticResource Btn.IconSmall}" Content="&#xE71E;" Click="ZoomIn_Click"
                        ToolTip="Inzoomen" Width="25" Height="25" />
                <Button Grid.Column="4" Style="{StaticResource Btn.IconSmall}" Content="&#xE8A7;" Click="External_Click"
                        ToolTip="Extern openen" Width="25" Height="25" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

            <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Canvas}">
                <Image x:Name="Picture" Stretch="None" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer>

            <Grid x:Name="MediaPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Canvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <MediaElement x:Name="Player" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                    <Border Width="60" Height="60" CornerRadius="{DynamicResource Radius.L}"
                            Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
                        <TextBlock x:Name="MediaIcon" Text="&#xE8D6;" Style="{StaticResource Text.Icon}" FontSize="25"
                                   Foreground="{DynamicResource Brush.Video}" />
                    </Border>
                    <TextBlock x:Name="MediaTitle" Text="" Style="{StaticResource Text.H3}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="Lokaal afspelen in je werkruimte" Style="{StaticResource Text.Tiny}"
                               TextAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" ValueChanged="PositionSlider_ValueChanged"
                                Thumb.DragStarted="Position_DragStarted" Thumb.DragCompleted="Position_DragCompleted"
                                Margin="0,0,0,4" />
                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton" Style="{StaticResource Btn.IconSmall}" Click="Play_Click"
                                        Content="&#xE768;" ToolTip="Afspelen" Width="28" Height="28" />
                                <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Style="{StaticResource Text.Tiny}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="&#xE767;" Style="{StaticResource Text.Icon}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Faint}" Margin="0,0,5,0" />
                                <Slider x:Name="VolumeSlider" Width="64" Minimum="0" Maximum="1" Value="0.8"
                                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="FallbackPanel" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="22">
                    <Border Width="46" Height="46" CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Brush.DocumentSoft}" HorizontalAlignment="Center">
                        <TextBlock x:Name="FallbackIcon" Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="20"
                                   Foreground="{DynamicResource Brush.Document}" />
                    </Border>
                    <TextBlock x:Name="FallbackTitle" Text="Geen ingebouwde viewer" Style="{StaticResource Text.H3}"
                               TextAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock x:Name="FallbackText" Text="" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="16" />
                    <Button Style="{StaticResource Btn.Secondary}" Content="Openen in standaardapp" Click="External_Click"
                            HorizontalAlignment="Center" Margin="0,13,0,0" FontSize="10.5" />
                </StackPanel>
            </Border>

            <Border x:Name="LoadingPanel" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="3" Foreground="{DynamicResource Brush.Accent}"
                                 Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="0" />
                    <TextBlock Text="Bestand openen…" Style="{StaticResource Text.Tiny}" Margin="0,9,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
