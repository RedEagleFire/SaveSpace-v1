<Window x:Class="SaveSpace.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video" Width="1180" Height="740" MinWidth="760" MinHeight="480" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource Brush.Canvas}"
        FontFamily="{DynamicResource Font.BodyFamily}" Foreground="{DynamicResource Brush.Ink}" PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.M}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerIcon" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
            <Border Height="5" CornerRadius="3" Background="{DynamicResource Brush.LineStrong}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Brush.Ink}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TopBar" Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" Padding="20,12" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   MaxWidth="680" />
                        <TextBlock x:Name="SubtitleText" FontSize="10.5" Foreground="#9C9186" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlayerButton}" Click="OpenExternal_Click" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Extern openen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlayerIcon}" Content="&#xE838;" Click="Reveal_Click"
                            ToolTip="Toon in Verkenner" Margin="0,0,7,0" />
                    <Button Style="{StaticResource PlayerIcon}" Content="&#xE74D;" Click="Delete_Click"
                            ToolTip="Naar prullenbak" Margin="0,0,12,0" />
                    <Button Style="{StaticResource PlayerIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Sluiten" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                          ScrubbingEnabled="True" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed" />

            <Button x:Name="CenterPlayButton" Click="PlayPause_Click" Width="88" Height="88" Cursor="Hand"
                    Background="#B30C0B0A" BorderThickness="0" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                            <TextBlock x:Name="Glyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="28" Foreground="#FFF7ED" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D90C0B0A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                           Foreground="#F06A5C" HorizontalAlignment="Center" />
                <TextBlock Text="Deze video kan niet worden afgespeeld" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,14,0,6" />
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#9C9186" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource PlayerButton}" Content="Open met standaardspeler"
                            Click="OpenExternal_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PlayerButton}" Content="Toon in Verkenner" Click="Reveal_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border x:Name="BottomBar" Grid.Row="2" Background="#D90C0B0A" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTime" Text="0:00" FontSize="10.5" Foreground="#9C9186"
                               VerticalAlignment="Center" />
                    <Slider x:Name="Timeline" Grid.Column="1" Style="{StaticResource PlayerSlider}" Margin="12,0"
                            Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged"
                            PreviewMouseLeftButtonDown="Timeline_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Timeline_PreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="TotalTime" Grid.Column="2" Text="0:00" FontSize="10.5" Foreground="#9C9186"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerIcon}" Content="&#xE768;"
                                Click="PlayPause_Click" ToolTip="Afspelen (spatie)" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PlayerIcon}" Content="&#xE892;" Click="Back_Click"
                                ToolTip="10 seconden terug" />
                        <Button Style="{StaticResource PlayerIcon}" Content="&#xE893;" Click="Forward_Click"
                                ToolTip="10 seconden vooruit" Margin="0,0,8,0" />
                        <Button x:Name="MuteButton" Style="{StaticResource PlayerIcon}" Content="&#xE767;"
                                Click="Mute_Click" ToolTip="Geluid" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="100" Margin="7,0,0,0"
                                Minimum="0" Maximum="1" Value="0.8" ValueChanged="Volume_ValueChanged"
                                ToolTip="Volume" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Spatie · ← → · F voor volledig scherm" FontSize="10.5" Foreground="#6E655B"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource PlayerIcon}" Content="&#xE740;"
                                Click="Fullscreen_Click" ToolTip="Volledig scherm (F)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
