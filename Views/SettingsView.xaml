<UserControl x:Class="SaveSpace.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="SettingsNav" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.S}">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="2" HorizontalAlignment="Left" Margin="2,6" Visibility="Collapsed" />
                                <ContentPresenter Margin="8,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.L}" Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="17" Foreground="{DynamicResource Brush.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="JOUW WERKRUIMTE" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" />
                    <TextBlock Text="Instellingen" Style="{StaticResource Text.H1}" FontSize="23" Margin="0,1,0,0" />
                    <TextBlock Text="Pas uiterlijk, opslag en privacy aan. Je keuzes worden lokaal bewaard."
                               Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="{DynamicResource Radius.M}"
                        Padding="10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Lokaal opgeslagen" FontSize="10.5" Foreground="{DynamicResource Brush.Ink}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Padding="8,10" VerticalAlignment="Top">
                <StackPanel>
                    <ToggleButton x:Name="NavGeneral" Style="{StaticResource SettingsNav}" IsChecked="True" Click="Nav_Click" Tag="general">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0" />
                            <TextBlock Text="Algemeen" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavStorage" Style="{StaticResource SettingsNav}" Click="Nav_Click" Tag="storage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0" />
                            <TextBlock Text="Opslag &amp; back-ups" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavAi" Style="{StaticResource SettingsNav}" Click="Nav_Click" Tag="ai">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="AI &amp; API" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavBrowser" Style="{StaticResource SettingsNav}" Click="Nav_Click" Tag="browser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0" />
                            <TextBlock Text="Browser &amp; privacy" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavEditor" Style="{StaticResource SettingsNav}" Click="Nav_Click" Tag="editor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0" />
                            <TextBlock Text="Editor &amp; sneltoetsen" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavAbout" Style="{StaticResource SettingsNav}" Click="Nav_Click" Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,11,0" />
                            <TextBlock Text="Over SaveSpace" FontSize="13.5" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="6,10" />
                    <TextBlock Text="SaveSpace 1.0" Style="{StaticResource Text.Tiny}" FontSize="10" Margin="10,2,0,2" />
                    <TextBlock Text="Lokaal en van jou" Style="{StaticResource Text.Tiny}" FontSize="9.5" Margin="10,0,0,4"
                               Foreground="{DynamicResource Brush.Faint}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,26">
                <StackPanel>
                    <!-- ALGEMEEN -->
                    <StackPanel x:Name="PanelGeneral">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Lay-out" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies een stijl. De voorbeeldkaart past direct mee aan." Style="{StaticResource CardHint}" />
                                <ComboBox x:Name="LayoutPresetBox" Margin="0,12,0,0" Padding="10,8" SelectedValuePath="Tag"
                                          SelectionChanged="LayoutPreset_SelectionChanged">
                                    <ComboBoxItem Tag="claude">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="Claude-stijl" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Veel leesruimte, rustige vlakken" Style="{StaticResource CardHint}" FontSize="11" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="apple">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="Apple-stijl" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Vloeiende glaslagen en kleurlicht" Style="{StaticResource CardHint}" FontSize="11" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="focus">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="Focus" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Schrijven zonder afleiding" Style="{StaticResource CardHint}" FontSize="11" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="library">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="Bibliotheek" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Alles snel vinden" Style="{StaticResource CardHint}" FontSize="11" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <Border x:Name="LayoutPreview" Background="{DynamicResource Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.M}" Padding="14" Margin="0,14,0,0">
                                    <Grid Height="170">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Mini-zijbalk -->
                                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.S}" Padding="12">
                                            <StackPanel>
                                                <Border Height="6" Width="40" Background="{DynamicResource Brush.Accent}" CornerRadius="3" HorizontalAlignment="Left" />
                                                <Border Height="6" Width="78" Background="{DynamicResource Brush.LineStrong}" CornerRadius="3" Margin="0,16,0,0" />
                                                <Border Height="6" Width="64" Background="{DynamicResource Brush.Line}" CornerRadius="3" Margin="0,10,0,0" />
                                                <Border Height="6" Width="72" Background="{DynamicResource Brush.Line}" CornerRadius="3" Margin="0,10,0,0" />
                                                <Border Height="6" Width="56" Background="{DynamicResource Brush.Line}" CornerRadius="3" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tekst en voorbeeldkaarten -->
                                        <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LayoutPreviewTitle" Text="Claude-stijl" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock x:Name="LayoutPreviewText" Text="Warm donker palet, serif-koppen en ruime leesbreedte."
                                                       Style="{StaticResource CardHint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="44" Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.S}" Padding="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Border Height="5" Width="48" Background="{DynamicResource Brush.LineStrong}" CornerRadius="2" HorizontalAlignment="Left" />
                                                        <Border Height="4" Width="70" Background="{DynamicResource Brush.Line}" CornerRadius="2" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Height="44" Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.S}" Padding="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Border Height="5" Width="40" Background="{DynamicResource Brush.Accent}" CornerRadius="2" HorizontalAlignment="Left" />
                                                        <Border Height="4" Width="62" Background="{DynamicResource Brush.Line}" CornerRadius="2" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Home-widgets" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies welke overzichtskaarten op Home verschijnen. Je kunt ze later weer uitzetten."
                                           Style="{StaticResource CardHint}" />
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <CheckBox x:Name="WidgetFavorites" Content="Favorieten" Tag="favorites" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetProjects" Content="Projecten" Tag="projects" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetNotes" Content="Notities" Tag="notes" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetDocuments" Content="Documenten" Tag="documents" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetImages" Content="Afbeeldingen" Tag="images" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetVideos" Content="Video's" Tag="videos" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetAudio" Content="Muziek" Tag="audio" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetLinks" Content="Weblinks" Tag="links" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetTrash" Content="Prullenbak" Tag="trash" Click="HomeWidget_Click" Margin="0,5" />
                                    <CheckBox x:Name="WidgetBackup" Content="Back-upstatus" Tag="backup" Click="HomeWidget_Click" Margin="0,5" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Home-achtergrond" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies een subtiele kleurgloed. De tint loopt vanzelf over in de achtergrond."
                                           Style="{StaticResource CardHint}" />
                                <WrapPanel x:Name="HomeBackgroundPanel" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Weergave" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies een donker of licht uiterlijk. De rode accentkleur blijft herkenbaar."
                                           Style="{StaticResource CardHint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ToggleButton x:Name="ThemeDark" Style="{StaticResource Btn.Nav}" Tag="dark" Click="Theme_Click"
                                                  IsChecked="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE708;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Donker" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ThemeLight" Style="{StaticResource Btn.Nav}" Tag="light" Click="Theme_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE706;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Licht" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ThemeSystem" Style="{StaticResource Btn.Nav}" Tag="system" Click="Theme_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE771;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Systeem" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Accentkleur" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="De accentkleur wordt gebruikt voor actieve knoppen, notities en markeringen."
                                           Style="{StaticResource CardHint}" />
                                <WrapPanel x:Name="AccentPanel" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Vormgeving" Style="{StaticResource CardTitle}" />
                                    <Button Style="{StaticResource Btn.Ghost}" Content="Standaard herstellen" Click="ResetAppearance_Click"
                                            HorizontalAlignment="Right" FontSize="10.5" Padding="7,3" />
                                </Grid>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Afronding" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="18" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="RadiusSlider_ValueChanged" />
                                    <TextBlock x:Name="RadiusValue" Grid.Column="2" Text="10" Style="{StaticResource Text.Tiny}"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tekstgrootte" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <Slider x:Name="FontSlider" Grid.Column="1" Minimum="0.85" Maximum="1.35" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" ValueChanged="FontSlider_ValueChanged" />
                                    <TextBlock x:Name="FontValue" Grid.Column="2" Text="100%" Style="{StaticResource Text.Tiny}"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Stille animaties" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="AnimationsToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="Animations_Click" />
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <TextBlock Text="Compacte bediening" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="CompactToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="Compact_Click" />
                                </Grid>
                                <TextBlock Text="Voorbeeld van tekstgrootte" Style="{StaticResource Text.Tiny}" Margin="0,10,0,0" />
                                <TextBlock Text="Een notitie voelt prettig leesbaar." FontSize="{DynamicResource Font.Body}"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Bibliotheek" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="De naam die in de kop van je bibliotheek verschijnt." Style="{StaticResource CardHint}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LibraryNameBox" Style="{StaticResource Input}" MaxLength="60" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Opslaan"
                                            Click="SaveLibraryName_Click" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Bestanden toevoegen" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies welke map standaard opent wanneer je een bestand aan een notitie toevoegt."
                                           Style="{StaticResource CardHint}" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AttachmentFolderBox" Style="{StaticResource Input}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Kies map…"
                                            Click="ChooseAttachmentFolder_Click" Margin="8,0,0,0" />
                                </Grid>
                                <Button Style="{StaticResource Btn.Secondary}" Content=".noteagent openen vanuit Verkenner"
                                        Click="RegisterNotePackage_Click" Margin="0,11,0,0" HorizontalAlignment="Left" />
                                <TextBlock x:Name="FileAssociationStatus" Text="" Style="{StaticResource CardHint}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- OPSLAG -->
                    <StackPanel x:Name="PanelStorage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Notities samenvoegen" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Voeg geëxporteerde .noteagent-notities toe aan deze bibliotheek. Bijlagen komen mee; notities die al bestaan worden overgeslagen."
                                           Style="{StaticResource CardHint}" />
                                <Button Style="{StaticResource Btn.Secondary}" Content="Notitiebestanden kiezen…"
                                        Click="ImportNotePackages_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                <TextBlock x:Name="MergeStatusText" Text="" Style="{StaticResource CardHint}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Opslagmap" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Je bibliotheek staat lokaal. Bij verhuizen wordt alles gekopieerd; de oude map blijft bewaard."
                                           Style="{StaticResource CardHint}" />
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.S}"
                                        Padding="10,8" Margin="0,10,0,0">
                                    <TextBlock x:Name="StoragePathText" Text="" Style="{StaticResource Text.Tiny}" FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource Btn.Secondary}" Content="Map openen" Click="OpenStorage_Click"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Secondary}" Content="Verhuizen naar…" Click="MoveStorage_Click" />
                                </StackPanel>
                                <TextBlock x:Name="StorageStatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="2,7,0,0"
                                           Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Back-ups" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="LastBackupText" Text="" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Een compacte back-up bevat de database. Een volledige back-up bevat ook foto's, video's en documenten."
                                           Style="{StaticResource CardHint}" />
                                <TextBlock Text="Je kunt een tweede kopie laten bewaren in een gesynchroniseerde map, zoals OneDrive."
                                           Style="{StaticResource CardHint}" Margin="0,6,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupMirrorFolderBox" Style="{StaticResource Input}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Kies map…"
                                            Click="ChooseBackupMirrorFolder_Click" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Wissen"
                                            Click="ClearBackupMirrorFolder_Click" Margin="4,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Content="Nu back-uppen" Click="Backup_Click" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Secondary}" Content="Volledige back-up" Click="FullBackup_Click"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Ghost}" Content="Map openen" Click="OpenBackups_Click" />
                                </StackPanel>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Automatisch dagelijks back-uppen" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="AutoBackupToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="AutoBackup_Click" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Back-ups bewaren" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="KeepBox" Width="52" TextAlignment="Center" Padding="6,4" MaxLength="2"
                                                 LostFocus="KeepBox_LostFocus" />
                                        <TextBlock Text="stuks" Style="{StaticResource Text.Tiny}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Beschikbare back-ups" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Herstel een back-up als je iets wilt terugdraaien. SaveSpace start daarna opnieuw."
                                           Style="{StaticResource CardHint}" />
                                <ItemsControl x:Name="BackupList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.S}"
                                                    Padding="10,8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DateLabel}" FontSize="11.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Tiny}" FontSize="9.5" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource Text.Tiny}"
                                                               VerticalAlignment="Center" Margin="10,0" />
                                                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Herstellen"
                                                            Tag="{Binding}" Click="RestoreBackup_Click" FontSize="10" Padding="7,3" />
                                                    <Button Grid.Column="3" Style="{StaticResource Btn.IconSmall}" Content="&#xE74D;"
                                                            Tag="{Binding}" Click="DeleteBackup_Click" ToolTip="Back-up verwijderen" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoBackupsText" Text="Nog geen back-ups gemaakt." Style="{StaticResource Text.Tiny}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Ontbrekende bestanden" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Zoek bestanden die eerder in de bibliotheek stonden maar niet meer op hun plek zijn."
                                                   Style="{StaticResource CardHint}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource Btn.Secondary}" Content="Controleren" Click="CheckMissingFiles_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="MissingFilesStatus" Text="" Style="{StaticResource CardHint}" Margin="0,9,0,0" />
                                <ItemsControl x:Name="MissingFilesList" Margin="0,7,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.S}"
                                                    Padding="9,7" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Prullenbak bewaren" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies hoe lang verwijderde items blijven staan. Verlopen items worden definitief gewist wanneer je de prullenbak opent."
                                           Style="{StaticResource CardHint}" />
                                <ComboBox x:Name="TrashRetentionBox" SelectedValuePath="Tag" Margin="0,10,0,0"
                                          SelectionChanged="TrashRetention_SelectionChanged">
                                    <ComboBoxItem Tag="0" Content="Nooit automatisch legen" />
                                    <ComboBoxItem Tag="30" Content="Na 30 dagen" />
                                    <ComboBoxItem Tag="60" Content="Na 60 dagen" />
                                    <ComboBoxItem Tag="90" Content="Na 90 dagen" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- AI -->
                    <StackPanel x:Name="PanelAi" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="AI-provider" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Kies Ollama voor lokaal gebruik, of een externe provider met je eigen API-sleutel. Sleutels worden bewaard in Windows Referentiebeheer, niet in de database."
                                           Style="{StaticResource CardHint}" />
                                <WrapPanel x:Name="ProviderPanel" Margin="0,11,0,0" />
                                <TextBlock x:Name="ProviderHint" Text="" Style="{StaticResource Text.Tiny}" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Verbinding" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="ENDPOINT" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox x:Name="EndpointBox" Style="{StaticResource Input}" />
                                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ModelBox" Style="{StaticResource Input}" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Modellen ophalen"
                                            Click="FetchModels_Click" Margin="8,0,0,0" />
                                </Grid>
                                <WrapPanel x:Name="ModelSuggestions" Margin="0,8,0,0" />
                                <TextBlock Text="API-SLEUTEL" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="KeyBox" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Opslaan"
                                            Click="SaveKey_Click" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Verwijderen"
                                            Click="RemoveKey_Click" Margin="4,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="KeyStatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="2,7,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Content="Instellingen opslaan" Click="SaveAi_Click"
                                            Margin="0,0,6,0" />
                                    <Button x:Name="TestAiButton" Style="{StaticResource Btn.Secondary}" Content="Verbinding testen"
                                            Click="TestAi_Click" />
                                </StackPanel>
                                <TextBlock x:Name="AiStatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="2,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Wat de assistent wel en niet doet" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="De assistent kan notities samenvatten, herschrijven en titels voorstellen. Je ziet altijd eerst het voorstel en bevestigt belangrijke wijzigingen. Er wordt niets automatisch verwijderd. Bij externe providers wordt alleen de tekst die je zelf meestuurt verstuurd."
                                           Style="{StaticResource CardHint}" LineHeight="16" />
                                <TextBlock Text="Bestanden en documenten worden niet automatisch naar een AI-provider geüpload."
                                           Style="{StaticResource CardHint}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- BROWSER -->
                    <StackPanel x:Name="PanelBrowser" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Startpagina" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="De pagina die opent in de ingebouwde browser van je werkruimte." Style="{StaticResource CardHint}" />
                                <TextBox x:Name="BrowserHomeBox" Style="{StaticResource Input}" Margin="0,10,0,0" />
                                <TextBlock Text="ZOEKMACHINE" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <WrapPanel>
                                    <ToggleButton x:Name="EngineDuck" Style="{StaticResource Btn.Nav}" Tag="duckduckgo" Click="Engine_Click" Content="DuckDuckGo" />
                                    <ToggleButton x:Name="EngineGoogle" Style="{StaticResource Btn.Nav}" Tag="google" Click="Engine_Click" Content="Google" />
                                    <ToggleButton x:Name="EngineBing" Style="{StaticResource Btn.Nav}" Tag="bing" Click="Engine_Click" Content="Bing" />
                                </WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="Browserinstellingen opslaan" Click="SaveBrowser_Click"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" />
                                <TextBlock x:Name="BrowserStatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="2,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Privacy" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="De ingebouwde browser gebruikt de WebView2-runtime van Windows. Browsegegevens blijven in je lokale cache. SaveSpace bewaart geen wachtwoorden en synchroniseert niets."
                                           Style="{StaticResource CardHint}" LineHeight="16" />
                                <Button Style="{StaticResource Btn.Secondary}" Content="Browsergegevens wissen" Click="ClearBrowser_Click"
                                        HorizontalAlignment="Left" Margin="0,11,0,0" />
                                <TextBlock x:Name="PrivacyStatusText" Text="" Style="{StaticResource Text.Tiny}" Margin="2,7,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="AI-sleutels" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Verwijder opgeslagen sleutels uit Windows Referentiebeheer. Je moet ze daarna opnieuw invoeren als je AI wilt gebruiken."
                                           Style="{StaticResource CardHint}" />
                                <Button Style="{StaticResource Btn.Danger}" Content="Alle AI-sleutels verwijderen" Click="RemoveAllKeys_Click"
                                        HorizontalAlignment="Left" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- EDITOR -->
                    <StackPanel x:Name="PanelEditor" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Schrijven" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,11,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Spellingscontrole" Style="{StaticResource Text.Small}" />
                                        <TextBlock Text="Markeer woorden tijdens het typen. De tekst zelf wordt nooit verstuurd."
                                                   Style="{StaticResource CardHint}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SpellcheckToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Click="Spellcheck_Click" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,12" />
                                <TextBlock Text="Automatisch opslaan" Style="{StaticResource Text.Small}" />
                                <TextBlock Text="Notities worden bewaard terwijl je typt en bij het wisselen van notitie. De status onderaan de editor laat zien wanneer het gelukt is."
                                           Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <StackPanel Margin="0,0,50,0">
                                    <TextBlock Text="Hoog contrast" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Maak tekst, randen en bediening extra duidelijk. Je kunt de hele app ook met het toetsenbord bedienen."
                                               Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <ToggleButton x:Name="HighContrastToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Click="HighContrast_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Sneltoetsen" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Deze sneltoetsen werken in de hele app." Style="{StaticResource CardHint}" />
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + K" Style="{StaticResource Text.Small}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Zoeken in je hele bibliotheek" Style="{StaticResource Text.Small}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + N" Style="{StaticResource Text.Small}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Nieuwe notitie" Style="{StaticResource Text.Small}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + B / I / U" Style="{StaticResource Text.Small}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Vet, cursief en onderstreept in de editor" Style="{StaticResource Text.Small}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + Shift + D" Style="{StaticResource Text.Small}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Wisselen tussen donker en licht" Style="{StaticResource Text.Small}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Esc" Style="{StaticResource Text.Small}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Pop-ups sluiten" Style="{StaticResource Text.Small}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- OVER -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="54" Height="54" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.AccentSoft}">
                                    <TextBlock Text="N" FontFamily="{DynamicResource Font.DisplayFamily}" FontSize="27"
                                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="SaveSpace" Style="{StaticResource Text.H2}" />
                                    <TextBlock Text="Versie 1.0 · Windows 10 en 11" Style="{StaticResource Text.Tiny}" />
                                    <TextBlock Text="Notities, projecten, documenten en een rustige werkruimte." Style="{StaticResource Text.Small}"
                                               FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Jouw bibliotheek" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AboutStatsText" Text="" Style="{StaticResource Text.Small}" Margin="0,8,0,0" />
                                <TextBlock x:Name="AboutStorageText" Text="" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Btn.Secondary}" Content="Opslagmap openen" Click="OpenStorage_Click"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Ghost}" Content="Logbestand openen" Click="OpenLog_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Privacy en eigendom" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Alles wat je in SaveSpace bewaart, staat op deze computer. Er is geen account en geen cloudopslag. Originele bestanden die je importeert, worden nooit automatisch verwijderd. Alleen als je zelf een AI-provider gebruikt, wordt de tekst die je naar de assistent stuurt verstuurd."
                                           Style="{StaticResource CardHint}" LineHeight="17" />
                                <TextBlock Text="Deze build bevat geen automatische updater en geen installer. Publiceren gebeurt via de meegeleverde publish-map."
                                           Style="{StaticResource CardHint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
