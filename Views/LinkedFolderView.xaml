<UserControl x:Class="SaveSpace.Views.LinkedFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72B;" Click="Back_Click" ToolTip="Terug naar projecten"
                        Margin="0,0,8,0" />
                <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.FolderSoft}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="17"
                               Foreground="{DynamicResource Brush.Folder}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock x:Name="NameText" Text="" Style="{StaticResource Text.H1}" FontSize="24" />
                    <TextBlock x:Name="PathText" Text="" Style="{StaticResource Text.Tiny}" FontSize="10" MaxWidth="760"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Secondary}" Click="Up_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Omhoog" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Secondary}" Click="Explore_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="In Verkenner" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Ghost}" Click="RemoveLink_Click" Foreground="{DynamicResource Brush.Danger}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Ontkoppelen" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GEKOPPELDE MAP" Style="{StaticResource Text.Eyebrow}" FontSize="9.5" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}" Height="32" Padding="11,0"
                    MaxWidth="300" HorizontalAlignment="Right" Margin="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="11"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,7,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Zoek in deze map…" Foreground="{DynamicResource Brush.Faint}" FontSize="11.5"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="11.5"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Column="2" x:Name="CountText" Text="" Style="{StaticResource Text.Tiny}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Margin="0,0,0,4"
                                    MouseLeftButtonUp="Entry_MouseLeftButtonUp" Cursor="Hand" Tag="{Binding}">
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="{DynamicResource Radius.S}"
                                            Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="13"
                                                   Foreground="{Binding IconBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Text.Tiny}"
                                               Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource Text.Tiny}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedLabel}" Style="{StaticResource Text.Tiny}"
                                               Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}"
                    Padding="30,26">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="28"
                               Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Text="Deze map is leeg" Style="{StaticResource Text.H2}"
                               TextAlignment="Center" Margin="0,12,0,5" />
                    <TextBlock x:Name="EmptyText" Text="SaveSpace leest de map alleen. Bestanden blijven op hun plek staan."
                               Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
