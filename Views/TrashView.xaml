<UserControl x:Class="SaveSpace.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="PRULLENBAK" Style="{StaticResource Text.Eyebrow}" FontSize="10" />
                <TextBlock Text="Prullenbak" Style="{StaticResource Text.H1}" Margin="0,3,0,0" />
                <TextBlock x:Name="SubtitleText" Text="Verwijderde items blijven hier tot je ze terugzet of definitief wist."
                           Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="EmptyTrashButton" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="EmptyTrash_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Prullenbak legen" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="CountText" Text="" Style="{StaticResource Text.Tiny}" Margin="0,14,0,10" />

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TrashList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Margin="0,0,0,5">
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.S}"
                                            Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,11,0" Opacity="0.7">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" FontSize="14"
                                                   Foreground="{Binding AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Text.Tiny}" FontSize="10" />
                                            <TextBlock Text="  ·  verwijderd " Style="{StaticResource Text.Tiny}" FontSize="10" />
                                            <TextBlock Text="{Binding DeletedAt, StringFormat={}{0:d MMM yyyy, HH:mm}}"
                                                       Style="{StaticResource Text.Tiny}" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Content="Terugzetten"
                                            Tag="{Binding}" Click="Restore_Click" FontSize="10.5" Padding="9,4" Margin="0,0,6,0" />
                                    <Button Grid.Column="3" Style="{StaticResource Btn.IconSmall}" Content="&#xE74D;"
                                            Tag="{Binding}" Click="Delete_Click" ToolTip="Definitief verwijderen"
                                            Foreground="{DynamicResource Brush.Danger}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}"
                    Padding="30,26">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                    <Border Width="46" Height="46" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.SurfaceAlt}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="19"
                                   Foreground="{DynamicResource Brush.Faint}" />
                    </Border>
                    <TextBlock Text="De prullenbak is leeg" Style="{StaticResource Text.H2}" TextAlignment="Center"
                               Margin="0,14,0,5" />
                    <TextBlock Text="Items die je verwijdert, blijven hier staan tot je ze definitief wist."
                               Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
