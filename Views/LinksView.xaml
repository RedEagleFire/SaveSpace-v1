<UserControl x:Class="SaveSpace.Views.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <UserControl.Resources>
        <Style x:Key="LinkCard" TargetType="Button">
            <Setter Property="Width" Value="348" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.L}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource Shadow.Soft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkAction" TargetType="Button" BasedOn="{StaticResource Btn.IconSmall}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,24,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Weblinks" Style="{StaticResource Text.H1}" />
                <TextBlock x:Name="SubtitleText" Text="Bewaar interessante pagina's met titel en omschrijving."
                           Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="NewLink_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="Nieuwe link" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}" Height="40" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,0,8,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Zoek in je links…" Foreground="{DynamicResource Brush.Faint}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="12"
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>
            <Button x:Name="SortButton" Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="Nieuwste eerst"
                    Margin="8,0,0,0" Click="Sort_Click" />
            <TextBlock Grid.Column="3" x:Name="CountLabel" Text="" Style="{StaticResource Text.Tiny}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LinksList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkCard}" Tag="{Binding}" Click="OpenLink_Click"
                                    ToolTip="{Binding Url}">
                                <Grid Margin="18,15,14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.M}"
                                                Background="{DynamicResource Brush.LinkSoft}">
                                            <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="15"
                                                       Foreground="{DynamicResource Brush.Link}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Domain}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Link}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                       FontSize="10.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource LinkAction}" Tag="{Binding}"
                                                Click="Favorite_Click" ToolTip="Favoriet">
                                            <TextBlock Text="{Binding FavoriteGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource Brush.DarkYellow}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontFamily="{DynamicResource Font.DisplayFamily}"
                                               FontSize="18" Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap"
                                               MaxHeight="52" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Text="{Binding Content}" Style="{StaticResource Text.Small}"
                                               FontSize="11.8" MaxHeight="38" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="3" Text="{Binding Tags}" Style="{StaticResource Text.Tiny}"
                                               Foreground="{DynamicResource Brush.Faint}" Margin="0,9,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />

                                    <Grid Grid.Row="4" Margin="0,10,0,0">
                                        <Border Height="1" Background="{DynamicResource Brush.Line}" VerticalAlignment="Top"
                                                Margin="0,0,0,9" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="8,4" FontSize="10.5"
                                                    Tag="{Binding}" Click="Edit_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="10"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="Bewerken" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="8,4" FontSize="10.5"
                                                    Tag="{Binding}" Click="Folder_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Sage}" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding FolderName, TargetNullValue=Geen map}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource Btn.IconSmall}" Tag="{Binding}" Click="Reveal_Click"
                                                    ToolTip="Open in browser" Content="&#xE8A7;" FontSize="12" />
                                            <Button Style="{StaticResource Btn.IconSmall}" Tag="{Binding}" Click="Delete_Click"
                                                    ToolTip="Naar prullenbak" Content="&#xE74D;" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="430">
                <Border Width="74" Height="74" CornerRadius="{DynamicResource Radius.L}"
                        Background="{DynamicResource Brush.LinkSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="30"
                               Foreground="{DynamicResource Brush.Link}" />
                </Border>
                <TextBlock Text="Nog geen weblinks" Style="{StaticResource Text.H2}" TextAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Bewaar een artikel, video of pagina die je later terug wilt vinden. SaveSpace bewaart titel, omschrijving en notities lokaal."
                           Style="{StaticResource Text.Small}" TextAlignment="Center" />
                <Button Style="{StaticResource Btn.Primary}" Content="Eerste link bewaren" Click="NewLink_Click"
                        Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
