<Application x:Class="SaveSpace.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SaveSpace.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToCollapsed" Invert="True" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:EmptyStringToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
            <conv:FileExistsToVisibilityConverter x:Key="FileExistsToVis" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:ImageBrushConverter x:Key="ImageBrush" />
            <conv:NullableLongToVisibilityConverter x:Key="FolderToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
