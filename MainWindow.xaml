<Window x:Class="SaveSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SaveSpace.Controls"
        Title="SaveSpace" Width="1480" Height="940" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Canvas}" FontFamily="{DynamicResource Font.BodyFamily}"
        FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowBtn" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
        </Style>

        <Style x:Key="HeaderBrand" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.DisplayFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ================= COMPACT HEADER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown" ClipToBounds="True">
            <Grid>
                <Border Background="{DynamicResource Brush.Header}" IsHitTestVisible="False" />
                <!-- Schaalbare rode lichtboog: meerdere zachte lagen geven diepte zonder de bediening te hinderen. -->
                <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="{DynamicResource Header.RedBeamOpacity}">
                    <Canvas Width="1600" Height="64" ClipToBounds="True">
                        <Path Data="M-12,69 C250,68 430,62 650,49 C930,33 1205,16 1615,-12"
                              Stroke="#9B0010" StrokeThickness="20" Opacity="0.14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Effect><BlurEffect Radius="18" /></Path.Effect>
                        </Path>
                        <Path Data="M-12,67 C250,66 430,60 650,47 C930,31 1205,14 1615,-14"
                              Stroke="#E00018" StrokeThickness="6" Opacity="0.23" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Effect><BlurEffect Radius="8" /></Path.Effect>
                        </Path>
                        <Path Data="M-12,65 C250,64 430,58 650,45 C930,29 1205,12 1615,-16"
                              Stroke="#F21D2F" StrokeThickness="1.1" Opacity="0.64" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M-12,64 C250,63 430,57 650,44 C930,28 1205,11 1615,-17"
                              Stroke="#FF6872" StrokeThickness="0.5" Opacity="0.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand + note switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Height="40" Padding="3,0,7,0" Click="Brand_Click"
                            ToolTip="Naar Home" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <controls:LogoMark Width="30" Height="30" VerticalAlignment="Center" />
                            <TextBlock Text="SaveSpace" Style="{StaticResource HeaderBrand}" Margin="9,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Line}" Margin="10,0,7,0" />
                    <Button x:Name="LibrarySwitcherButton" Style="{StaticResource Btn.Ghost}" Height="34" Padding="9,0,4,0"
                            Click="LibrarySwitcher_Click" ToolTip="Wissel van notitie">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SwitcherIcon" Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="13"
                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" />
                            <TextBlock x:Name="SwitcherLabel" Text="Mijn bibliotheek" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Icon}" FontSize="9"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProjectMenuButton" Style="{StaticResource Btn.IconSmall}" Width="26" Height="26"
                            Content="&#xE712;" FontSize="12" Click="ProjectMenu_Click" Margin="2,0,0,0"
                            ToolTip="Projectacties" />
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" Style="{StaticResource SearchShell}" MaxWidth="520" MinWidth="280" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" Margin="18,5,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,0,9,0" />
                        <Grid Grid.Column="1">
                            <TextBlock Text="Zoek in je hele bibliotheek…" Foreground="{DynamicResource Brush.Faint}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" FontSize="12"
                                     VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewButton" Style="{StaticResource Btn.Primary}" Width="34" Height="34" Padding="0"
                            Click="NewButton_Click" ToolTip="Nieuw (Ctrl+N)" Margin="0,0,7,0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE710;" />

                    <Button x:Name="HeaderAiButton" Style="{StaticResource Btn.Icon}" Width="29" Height="29"
                            Click="AiButton_Click" ToolTip="AI-assistent" Margin="1,0">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="13"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource Btn.Icon}" Width="34" Height="34"
                            Click="SettingsButton_Click" ToolTip="Instellingen" Content="&#xE713;" Margin="1,0" />

                    <Grid Margin="1,0" Visibility="Collapsed">
                        <Button x:Name="BellButton" Style="{StaticResource Btn.Icon}" Width="34" Height="34"
                                Click="BellButton_Click" ToolTip="Meldingen" Content="&#xE7ED;" />
                        <Border x:Name="BellBadge" Background="{DynamicResource Brush.Accent}" CornerRadius="8"
                                MinWidth="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,2,0,0" IsHitTestVisible="False" Visibility="Collapsed" Padding="4,0">
                            <TextBlock x:Name="BellBadgeText" Style="{StaticResource BadgeText}" Text="0" />
                        </Border>
                    </Grid>

                    <Button x:Name="ProfileButton" Style="{StaticResource Btn.Icon}" Click="ProfileButton_Click"
                            ToolTip="Profiel" Width="38" Margin="1,0" Visibility="Collapsed">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="{DynamicResource Brush.Accent}" />
                            <TextBlock x:Name="AvatarInitials" Text="JS" Foreground="{DynamicResource Brush.OnAccent}"
                                       FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Width="1" Height="22" Background="{DynamicResource Brush.Line}" Margin="9,0" />

                    <Button Style="{StaticResource WindowBtn}" Width="38" Height="32" Click="Minimize_Click"
                            ToolTip="Minimaliseren" Content="&#xE921;" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowBtn}" Width="38" Height="32"
                            Click="Maximize_Click" ToolTip="Maximaliseren" Content="&#xE922;" />
                    <Button Style="{StaticResource WindowCloseBtn}" Width="38" Height="32" Click="Close_Click"
                            ToolTip="Sluiten" Content="&#xE8BB;" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= PAGE HOST ================= -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="PageTranslate" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Lokaal opgeslagen" FontSize="10" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                    <Border Width="1" Height="13" Background="{DynamicResource Brush.LineStrong}" Margin="12,0" />
                    <TextBlock Text="SaveSpace" FontSize="10" Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Je bestanden blijven op deze computer" FontSize="10" Foreground="{DynamicResource Brush.Faint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= POPUPS ================= -->
        <Popup x:Name="NewPopup" PlacementTarget="{Binding ElementName=NewButton}" Placement="Bottom"
               VerticalOffset="8" HorizontalOffset="-190" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Padding="10" Width="310"
                    Effect="{DynamicResource Shadow.Hover}">
                <StackPanel>
                    <TextBlock Text="IETS NIEUWS BEWAREN" Style="{StaticResource Text.Eyebrow}" Margin="12,8,12,6" />
                    <Button Style="{StaticResource Btn.Menu}" Click="NewNote_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.NoteSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Note}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nieuwe notitie" FontWeight="SemiBold" />
                                <TextBlock Text="Schrijf iets dat je wilt onthouden" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="OpenNotePackage_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,11,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Notitiebestand openen" FontWeight="SemiBold" />
                                <TextBlock Text="Open een .noteagent-bestand met bijlagen" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="NewLink_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.LinkSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Link}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Weblink bewaren" FontWeight="SemiBold" />
                                <TextBlock Text="Bewaar een interessante pagina" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource Divider}" Margin="10,4" />
                    <Button Style="{StaticResource Btn.Menu}" Click="NewImages_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.ImageSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Image}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Afbeeldingen importeren" FontWeight="SemiBold" />
                                <TextBlock Text="Foto's worden veilig gekopieerd" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="NewVideos_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.VideoSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Video}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Video's importeren" FontWeight="SemiBold" />
                                <TextBlock Text="Voeg films en clips toe" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="NewDocuments_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.DocumentSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Document}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Documenten toevoegen" FontWeight="SemiBold" />
                                <TextBlock Text="Pdf's, Office-bestanden en meer" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource Divider}" Margin="10,4" />
                    <Button Style="{StaticResource Btn.Menu}" Click="NewFolder_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource Brush.FolderSoft}" Width="34" Height="34">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.Folder}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nieuwe map" FontWeight="SemiBold" />
                                <TextBlock Text="Groepeer items op jouw manier" Style="{StaticResource Text.Tiny}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
               VerticalOffset="8" HorizontalOffset="-300" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Width="380"
                    Effect="{DynamicResource Shadow.Hover}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,16,12">
                        <TextBlock Text="Meldingen" Style="{StaticResource Text.H3}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Ghost}" Padding="8,4"
                                FontSize="11" Click="MarkNotificationsRead_Click" Content="Alles gelezen" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="8,0">
                        <Grid>
                            <ItemsControl x:Name="NotificationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="{DynamicResource Radius.S}"
                                                    Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="13"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Tiny}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Text.Tiny}"
                                                           Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NotificationsEmpty" Text="Nog geen meldingen. Alles wat je toevoegt verschijnt hier."
                                       Style="{StaticResource Text.Small}" TextAlignment="Center" Margin="30,24" />
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" FontSize="11"
                                Click="ClearNotifications_Click" Content="Meldingen wissen" />
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Bottom"
               VerticalOffset="8" HorizontalOffset="-230" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Padding="16" Width="300"
                    Effect="{DynamicResource Shadow.Hover}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,2,0,12">
                        <Grid Width="44" Height="44">
                            <Ellipse Fill="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding Text, ElementName=AvatarInitials}" Foreground="{DynamicResource Brush.OnAccent}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileName" Text="Gebruiker" Style="{StaticResource Text.H3}" />
                            <TextBlock x:Name="LibraryLabel" Text="Mijn bibliotheek" Style="{StaticResource Text.Tiny}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.M}" Padding="12,9" Margin="0,0,0,10">
                        <TextBlock x:Name="ProfilePath" Text="" Style="{StaticResource Text.Tiny}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Border>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.M}" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE708;" Style="{StaticResource Text.Icon}" FontSize="14"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                                <TextBlock Text="Donkere modus" />
                            </StackPanel>
                            <ToggleButton x:Name="DarkModeToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource Btn.Menu}" Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Instellingen" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="ProfileBackup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Back-up maken" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Menu}" Click="OpenStorage_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Opslagmap openen" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Divider}" Margin="6,4" />
                    <Button Style="{StaticResource Btn.Menu}" Click="About_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Over SaveSpace" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="LibrarySwitcherPopup" PlacementTarget="{Binding ElementName=LibrarySwitcherButton}" Placement="Bottom"
               VerticalOffset="7" HorizontalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius.XL}" Width="360"
                    Effect="{DynamicResource Shadow.Hover}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,15,12,10">
                        <StackPanel>
                            <TextBlock Text="NOTITIES" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="Je open notities staan bovenaan. Wisselen kost geen tekst." Style="{StaticResource Text.Tiny}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8BB;" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="LibrarySwitcherClose_Click" ToolTip="Sluiten" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="7,0">
                            <ItemsControl x:Name="SwitcherNotesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Btn.Menu}" Tag="{Binding Note}" Click="SwitcherNote_Click"
                                                Padding="10,8" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="3" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                                                        Visibility="{Binding ActiveVisibility}" Margin="0,3,7,3" />
                                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="{DynamicResource Radius.S}"
                                                        Background="{Binding IconSoftBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource Text.Icon}" FontSize="13"
                                                               Foreground="{Binding IconBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Tiny}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                                                    <TextBlock Text="OPEN" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                                               Margin="0,0,7,0" Visibility="{Binding OpenVisibility}" />
                                                    <TextBlock Text="{Binding FavoriteGlyph}" Style="{StaticResource Text.Icon}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.DarkYellow}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="SwitcherEmpty" Text="Nog geen notities. Begin met een leeg vel."
                                   Style="{StaticResource Text.Small}" Margin="22,10,22,22" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="10">
                        <Grid>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Alle notities" Click="SwitcherAll_Click"
                                    HorizontalAlignment="Left" FontSize="11.5" />
                            <Button Style="{StaticResource Btn.Primary}" Click="SwitcherNew_Click" HorizontalAlignment="Right"
                                    FontSize="11.5" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Nieuwe notitie" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
